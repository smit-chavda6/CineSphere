# TMDB credentials — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Either a v3 API key (32 hex chars) or a v4 "API Read Access Token" (starts with eyJ...) works.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional. Some ISPs (e.g. Jio in India) block TMDB via DNS. By default the server
# resolves TMDB through public DNS (1.1.1.1, 8.8.8.8) when running locally.
# Set to "system" to use your normal DNS, or list your own servers, e.g. "9.9.9.9,1.1.1.1".
# TMDB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Public URL of the deployed site (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
